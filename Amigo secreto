<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#1f4d33">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>Amigo Secreto de Natal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f6efe4; --card:#fffcf6; --ink:#2b231d; --muted:#7b6d61; --line:#e7dac6;
  --red:#b02a20; --red-2:#8f1f17; --green:#1f4d33; --green-2:#163a26; --gold:#c8962b;
  --radius:16px; --shadow:0 1px 2px rgba(43,35,29,.06),0 6px 20px rgba(43,35,29,.07);
}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;padding-bottom:84px}
h1,h2,h3{font-family:Fraunces,Georgia,serif;font-weight:700;line-height:1.2;margin:0}
button,input,textarea,select{font:inherit;color:inherit}
.hidden{display:none!important}

/* Header */
header{background:var(--green);color:#fff;position:relative;overflow:hidden;padding:22px 20px 26px}
header::before{content:"";position:absolute;inset:0;opacity:.18;pointer-events:none;
  background-image:radial-gradient(#fff 1.2px,transparent 1.6px),radial-gradient(#fff 1px,transparent 1.4px);
  background-size:38px 38px,23px 23px;background-position:0 0,11px 17px}
.hwrap{max-width:640px;margin:0 auto;position:relative}
.kicker{font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.8}
header h1{font-size:28px;margin:4px 0 10px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:4px 11px;font-size:14px}
.chip.gold{background:var(--gold);border-color:var(--gold);color:#2b1d05;font-weight:600}

main{max-width:640px;margin:0 auto;padding:16px}
.banner{max-width:640px;margin:12px auto 0;padding:0 16px}
.banner div{background:#fff4d6;border:1px solid #ecd28d;color:#5c4510;border-radius:12px;padding:10px 14px;font-size:14px}

.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px;margin-bottom:14px}
.card h2{font-size:21px;margin-bottom:6px}
.card h3{font-size:17px;margin-bottom:4px}
.muted{color:var(--muted)}
.small{font-size:14px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.stack>*+*{margin-top:10px}
.section-title{display:flex;justify-content:space-between;align-items:baseline;margin:22px 4px 10px}
.section-title h2{font-size:20px}

.btn{appearance:none;border:0;border-radius:12px;padding:12px 16px;font-weight:600;cursor:pointer;background:var(--red);color:#fff;transition:transform .05s,background .15s;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;min-height:46px}
.btn:hover{background:var(--red-2)}
.btn:active{transform:scale(.98)}
.btn:disabled{opacity:.55;cursor:default}
.btn.green{background:var(--green)} .btn.green:hover{background:var(--green-2)}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)} .btn.ghost:hover{background:#f1e7d8}
.btn.link{background:none;color:var(--red);padding:4px 2px;min-height:0;font-weight:600}
.btn.block{width:100%}
.btn.sm{padding:8px 12px;min-height:36px;font-size:14px;border-radius:10px}

/* People */
.person{background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:8px;overflow:hidden}
.person summary{list-style:none;display:flex;align-items:center;gap:12px;padding:12px 14px;cursor:pointer}
.person summary::-webkit-details-marker{display:none}
.avatar{width:42px;height:42px;border-radius:50%;background:#f1e5d3;display:grid;place-items:center;font-size:22px;flex:none}
.person .name{font-weight:600}
.person .chev{margin-left:auto;color:var(--muted);transition:transform .2s}
.person[open] .chev{transform:rotate(90deg)}
.pbody{padding:0 14px 14px 68px;font-size:15px}
.field-l{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-top:8px}
.pre{white-space:pre-wrap;word-wrap:break-word}
.tag{display:inline-block;font-size:12px;background:#e9f1ec;color:var(--green);border-radius:999px;padding:2px 8px;margin-left:6px;font-weight:600}

/* Reveal */
.reveal{width:100%;border:0;border-radius:20px;padding:34px 20px;background:linear-gradient(135deg,var(--red),#7d1912);color:#fff;cursor:pointer;box-shadow:var(--shadow);text-align:center}
.reveal .gift{font-size:64px;display:block;animation:wiggle 2.4s ease-in-out infinite}
@keyframes wiggle{0%,80%,100%{transform:rotate(0)}85%{transform:rotate(-8deg)}90%{transform:rotate(8deg)}95%{transform:rotate(-4deg)}}
.match{text-align:center;padding:26px 18px;background:linear-gradient(180deg,#fff,#fbf3e6)}
.match.anim{animation:pop .45s ease-out}
@keyframes pop{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
.match .avatar{width:84px;height:84px;font-size:44px;margin:8px auto 10px}
.match h2{font-size:30px}

/* Chat */
.chatlist{display:flex;flex-direction:column;gap:8px;padding-bottom:8px}
.msg{max-width:85%;padding:9px 13px;border-radius:16px;background:var(--card);border:1px solid var(--line);align-self:flex-start;word-wrap:break-word}
.msg .txt{white-space:pre-wrap}
.msg.mine{align-self:flex-end;background:#e7f0ea;border-color:#cfe0d5}
.msg .who{font-size:12px;font-weight:600;margin-bottom:2px;display:flex;gap:8px;align-items:center}
.msg .time{font-size:11px;color:var(--muted);margin-top:2px}
.msg .del{border:0;background:none;color:var(--red);cursor:pointer;font-size:12px;padding:0;margin-left:auto}
.composer{position:sticky;bottom:76px;display:flex;gap:8px;background:var(--bg);padding:8px 0}
.composer textarea{flex:1;resize:none;border:1px solid var(--line);border-radius:14px;padding:11px 13px;background:#fff;min-height:46px;max-height:120px}
.empty{text-align:center;color:var(--muted);padding:30px 10px}

/* Tabs */
nav.tabs{position:fixed;left:0;right:0;bottom:0;background:#fffcf6;border-top:1px solid var(--line);display:flex;justify-content:center;z-index:20;padding-bottom:env(safe-area-inset-bottom)}
nav.tabs .in{display:flex;max-width:640px;width:100%}
nav.tabs button{flex:1;border:0;background:none;padding:9px 4px 10px;cursor:pointer;color:var(--muted);font-size:12px;font-weight:600;display:flex;flex-direction:column;align-items:center;gap:2px;position:relative}
nav.tabs button .ic{font-size:22px;line-height:1.1;filter:grayscale(.6);opacity:.75}
nav.tabs button.on{color:var(--red)}
nav.tabs button.on .ic{filter:none;opacity:1}
.dot{position:absolute;top:6px;left:calc(50% + 10px);background:var(--red);color:#fff;font-size:10px;border-radius:999px;padding:0 5px;min-width:16px;line-height:16px}

/* Forms & modal */
.modal{position:fixed;inset:0;background:rgba(30,22,16,.45);z-index:50;display:flex;align-items:flex-end;justify-content:center}
.sheet{background:var(--card);width:100%;max-width:560px;max-height:92vh;overflow:auto;border-radius:22px 22px 0 0;padding:20px 18px 26px;animation:up .2s ease-out}
@media (min-width:640px){.modal{align-items:center}.sheet{border-radius:22px}}
@keyframes up{from{transform:translateY(30px);opacity:.4}to{transform:none;opacity:1}}
.sheet-h{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.sheet-h h2{font-size:22px;flex:1}
.x{border:0;background:#efe4d4;border-radius:50%;width:34px;height:34px;cursor:pointer;font-size:18px}
label.f{display:block;margin-bottom:12px}
label.f>span{display:block;font-weight:600;font-size:14px;margin-bottom:5px}
label.f>small{display:block;color:var(--muted);font-size:13px;margin-top:3px}
input[type=text],input[type=password],input[type=date],input[type=tel],textarea,select{width:100%;border:1px solid var(--line);border-radius:12px;padding:11px 12px;background:#fff;outline:none}
input:focus,textarea:focus,select:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(31,77,51,.12)}
textarea{min-height:84px;resize:vertical}
.emojis{display:flex;flex-wrap:wrap;gap:6px}
.emojis label{cursor:pointer}
.emojis input{position:absolute;opacity:0;pointer-events:none}
.emojis span{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;border:2px solid transparent;background:#f1e5d3;font-size:24px}
.emojis input:checked+span{border-color:var(--red);background:#fff}
.err{color:var(--red);font-size:14px;margin:4px 0 10px;min-height:1px}
.check{display:flex;gap:8px;align-items:center;font-size:14px;margin:6px 0 14px}
.pmhead{font-size:14px;color:var(--muted);margin:-6px 0 12px}
.pmlist{max-height:52vh;overflow:auto;padding:4px 2px 8px;display:flex;flex-direction:column;gap:8px}

.toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;padding:10px 16px;border-radius:12px;font-size:14px;opacity:0;transition:.25s;z-index:60;pointer-events:none;max-width:90vw;text-align:center}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.loader{text-align:center;padding:60px 10px;color:var(--muted)}
.spin{width:28px;height:28px;border:3px solid var(--line);border-top-color:var(--red);border-radius:50%;animation:sp 1s linear infinite;margin:0 auto 12px}
@keyframes sp{to{transform:rotate(360deg)}}
ol.how{padding-left:20px;margin:8px 0 0} ol.how li{margin-bottom:4px}
.pill-list{display:flex;flex-direction:column;gap:6px}
.pill-row{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--line);border-radius:12px;background:#fff}
.pill-row .grow{flex:1;min-width:0}
</style>
</head>
<body>
<header><div class="hwrap" id="hdr"></div></header>
<div class="banner" id="banner"></div>
<main id="main"></main>
<nav class="tabs" id="tabs"></nav>
<div class="modal hidden" id="modal"></div>
<div class="toast" id="toast"></div>

<script>
/* ==========================================================================
   CONFIGURAÇÃO — é só isto que precisa de alterar
   --------------------------------------------------------------------------
   1) FIREBASE: cole aqui o objeto "firebaseConfig" que o Firebase lhe dá
      (Definições do projeto > As suas apps > Web). Exemplo:
        FIREBASE: {
          apiKey: "AIza...",
          authDomain: "o-meu-projeto.firebaseapp.com",
          projectId: "o-meu-projeto",
          storageBucket: "o-meu-projeto.appspot.com",
          messagingSenderId: "123456789",
          appId: "1:123456789:web:abc123"
        },
      Se deixar null, a app funciona em "modo de demonstração" (os dados
      ficam só no seu dispositivo — serve para experimentar).
   2) GROUP: nome do grupo. Para fazer outro amigo secreto (ex.: para o ano,
      ou para outro grupo de amigos) com a mesma base de dados, basta mudar
      este nome. Use só letras, números e _
   ========================================================================== */
const CONFIG = {
  FIREBASE: null,
  GROUP: "natal2026",
};
</script>

<script>
"use strict";
/* ---------------- Utilitários ---------------- */
const $ = (s, el = document) => el.querySelector(s);
const $$ = (s, el = document) => [...el.querySelectorAll(s)];
const sleep = ms => new Promise(r => setTimeout(r, ms));
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const rid = (n = 16) => [...crypto.getRandomValues(new Uint8Array(n))].map(b => b.toString(16).padStart(2, "0")).join("");
const KEY = k => `amigo_${CONFIG.GROUP}_${k}`;
const lsGet = k => { try { return JSON.parse(localStorage.getItem(KEY(k))); } catch (e) { return null; } };
const lsSet = (k, v) => { try { v == null ? localStorage.removeItem(KEY(k)) : localStorage.setItem(KEY(k), JSON.stringify(v)); } catch (e) {} };
const EMOJIS = ["🎅","🤶","🦌","⛄","🎄","🎁","🍪","🌟","🔔","🧦","🐧","🦊","🐻","🦉","🍫","☕"];
const ALIASES = ["Rena Misteriosa","Duende Curioso","Pinguim Secreto","Boneco de Neve Tímido","Estrela Cadente","Biscoito de Gengibre","Sino Discreto","Meia Encantada","Floco de Neve","Coruja Noturna","Lareira Quentinha","Trenó Veloz","Bolota Mágica","Azevinho Calado","Pai Natal Disfarçado","Raposa do Norte"];
function toast(msg, ms = 2600) {
  const t = $("#toast"); t.textContent = msg; t.classList.add("on");
  clearTimeout(toast._t); toast._t = setTimeout(() => t.classList.remove("on"), ms);
}
function fmtDate(d) {
  if (!d) return "";
  const dt = new Date(d + "T12:00:00");
  return isNaN(dt) ? d : dt.toLocaleDateString("pt-PT", { day: "numeric", month: "long", year: "numeric" });
}
function daysLeft(d) {
  if (!d) return null;
  const t = new Date(d + "T00:00:00"), n = new Date(); n.setHours(0,0,0,0);
  return Math.round((t - n) / 864e5);
}
function fmtTime(ts) {
  const d = new Date(ts), now = new Date();
  const hm = d.toLocaleTimeString("pt-PT", { hour: "2-digit", minute: "2-digit" });
  return d.toDateString() === now.toDateString() ? hm : d.toLocaleDateString("pt-PT", { day: "numeric", month: "short" }) + " " + hm;
}

/* ---------------- Criptografia (o sorteio fica secreto até para o organizador) ---------------- */
const te = new TextEncoder(), td = new TextDecoder();
const b64 = buf => { let s = ""; new Uint8Array(buf).forEach(b => s += String.fromCharCode(b)); return btoa(s); };
const unb64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
const EC = { name: "ECDH", namedCurve: "P-256" };
async function pinKey(pin, salt) {
  const base = await crypto.subtle.importKey("raw", te.encode(pin), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey({ name: "PBKDF2", salt: unb64(salt), iterations: 150000, hash: "SHA-256" }, base, { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
}
async function hashPw(pw, salt) {
  const base = await crypto.subtle.importKey("raw", te.encode(pw), "PBKDF2", false, ["deriveBits"]);
  return b64(await crypto.subtle.deriveBits({ name: "PBKDF2", salt: unb64(salt), iterations: 150000, hash: "SHA-256" }, base, 256));
}
async function aesEnc(key, obj) {
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const ct = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, te.encode(JSON.stringify(obj)));
  return { iv: b64(iv), ct: b64(ct) };
}
async function aesDec(key, box) {
  const pt = await crypto.subtle.decrypt({ name: "AES-GCM", iv: unb64(box.iv) }, key, unb64(box.ct));
  return JSON.parse(td.decode(pt));
}
async function newKeyPair() {
  const kp = await crypto.subtle.generateKey(EC, true, ["deriveKey"]);
  return { pub: await crypto.subtle.exportKey("jwk", kp.publicKey), priv: await crypto.subtle.exportKey("jwk", kp.privateKey) };
}
async function sealFor(pubJwk, obj) {
  const eph = await crypto.subtle.generateKey(EC, true, ["deriveKey"]);
  const pub = await crypto.subtle.importKey("jwk", pubJwk, EC, false, []);
  const k = await crypto.subtle.deriveKey({ name: "ECDH", public: pub }, eph.privateKey, { name: "AES-GCM", length: 256 }, false, ["encrypt"]);
  const box = await aesEnc(k, obj);
  box.epk = await crypto.subtle.exportKey("jwk", eph.publicKey);
  return box;
}
async function openSealed(privJwk, box) {
  const priv = await crypto.subtle.importKey("jwk", privJwk, EC, false, ["deriveKey"]);
  const epk = await crypto.subtle.importKey("jwk", box.epk, EC, false, []);
  const k = await crypto.subtle.deriveKey({ name: "ECDH", public: epk }, priv, { name: "AES-GCM", length: 256 }, false, ["decrypt"]);
  return aesDec(k, box);
}

/* ---------------- Base de dados: Firebase, Claude ou demonstração local ---------------- */
function loadScript(src) {
  return new Promise((ok, ko) => { const s = document.createElement("script"); s.src = src; s.onload = ok; s.onerror = ko; document.head.appendChild(s); });
}
async function pickBackend() {
  for (let i = 0; i < 10 && !(window.claude && typeof window.claude.use === "function"); i++) await sleep(100);
  if (window.claude && typeof window.claude.use === "function") {
    try {
      const db = await Promise.race([window.claude.use("db"), sleep(10000).then(() => null)]);
      if (db) { S.mode = "claude"; return db; }
    } catch (e) {}
  }
  if (CONFIG.FIREBASE) {
    try {
      const v = "10.12.2";
      await loadScript(`https://www.gstatic.com/firebasejs/${v}/firebase-app-compat.js`);
      await loadScript(`https://www.gstatic.com/firebasejs/${v}/firebase-firestore-compat.js`);
      firebase.initializeApp(CONFIG.FIREBASE);
      S.mode = "firebase";
      return firebase.firestore();
    } catch (e) {
      console.error(e);
      S.warn = "Não foi possível ligar ao Firebase. Confirme a configuração. Por agora, a app está em modo de demonstração.";
    }
  }
  S.mode = "local";
  return makeLocalDb();
}
function makeLocalDb() {
  const SK = "amigo_demo_db";
  let store = {};
  const load = () => { try { store = JSON.parse(localStorage.getItem(SK) || "{}") || {}; } catch (e) {} };
  load();
  const subs = new Set();
  window.addEventListener("storage", e => { if (e.key === SK) { load(); fire(); } });
  const clone = o => o == null ? o : JSON.parse(JSON.stringify(o));
  const fire = () => subs.forEach(f => { try { f(); } catch (e) { console.error(e); } });
  const commit = () => { try { localStorage.setItem(SK, JSON.stringify(store)); } catch (e) {} setTimeout(fire, 0); };
  const meta = { fromCache: false, hasPendingWrites: false };
  const snapDoc = (col, id) => { const v = store[col] && store[col][id]; return { id, exists: !!v, data: () => v ? clone(v) : undefined, metadata: meta }; };
  function query(col, f = [], ob = null, lim = null) {
    const run = () => {
      let docs = Object.keys(store[col] || {}).map(id => snapDoc(col, id));
      docs = docs.filter(d => f.every(([k, op, v]) => op === "==" ? d.data()[k] === v : true));
      if (ob) { const [k, dir] = ob; docs.sort((a, b) => { const x = a.data()[k], y = b.data()[k]; return (x > y ? 1 : x < y ? -1 : 0) * (dir === "desc" ? -1 : 1); }); }
      if (lim) docs = docs.slice(0, lim);
      return { docs, size: docs.length, empty: !docs.length, metadata: meta };
    };
    return {
      where: (k, op, v) => query(col, [...f, [k, op, v]], ob, lim),
      orderBy: (k, dir = "asc") => query(col, f, [k, dir], lim),
      limit: n => query(col, f, ob, n),
      get: async () => run(),
      onSnapshot(next) { const fn = () => next(run()); subs.add(fn); setTimeout(fn, 0); return () => subs.delete(fn); }
    };
  }
  function docRef(col, id) {
    return {
      id,
      get: async () => snapDoc(col, id),
      async set(v) { (store[col] = store[col] || {})[id] = clone(v); commit(); },
      async update(v) { if (!store[col] || !store[col][id]) throw new Error("not found"); Object.assign(store[col][id], clone(v)); commit(); },
      async delete() { if (store[col]) delete store[col][id]; commit(); },
      onSnapshot(next) { const fn = () => next(snapDoc(col, id)); subs.add(fn); setTimeout(fn, 0); return () => subs.delete(fn); }
    };
  }
  return {
    collection(col) {
      return Object.assign({}, query(col), {
        doc: id => docRef(col, id || rid()),
        async add(v) { const r = docRef(col, rid()); await r.set(v); return r; }
      });
    }
  };
}
const C = name => S.db.collection(`${CONFIG.GROUP}_${name}`);

/* ---------------- Estado ---------------- */
const S = {
  mode: null, db: null, warn: null, err: null,
  cfg: null, people: [], chat: [], pm: {},
  loaded: { cfg: false, people: false },
  me: null, match: null, sealedSig: undefined, revealed: false,
  admin: false, tab: "people", openThread: null, pmUnsubs: [],
  alias: null
};

/* ---------------- Arranque ---------------- */
async function init() {
  S.tab = ["people","secret","chat","admin"].includes(location.hash.slice(1)) ? location.hash.slice(1) : "people";
  S.alias = lsGet("alias") || newAlias(
